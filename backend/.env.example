# ===================== Server =====================
APP_NAME=quant-trader
HOST=127.0.0.1
PORT=8000
DEBUG=true
# JSON list of allowed CORS origins (Vite dev server for stage 4)
CORS_ORIGINS=["http://localhost:5173"]

# ===================== Database =====================
# SQLite (default). For PostgreSQL later:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/quant_trader
DATABASE_URL=sqlite:///../data/quant_trader.db
DB_TIMEZONE=Asia/Shanghai
# Persist every tick to DB (batched once per second)
PERSIST_TICKS=true

# ===================== Simulator Gateway =====================
# SIM gateway is for tests/offline dev ONLY (simulated data).
# Production uses real data: STOCK + CTP auto-connect below.
ENABLE_SIM_GATEWAY=false
AUTO_CONNECT_SIM=false
SIM_TICK_INTERVAL=0.5

# ===================== Stock Gateway (A-share quotes) =====================
# Quote source: Tencent HTTP API (qt.gtimg.cn), 5-level book, polling.
ENABLE_STOCK_GATEWAY=true
AUTO_CONNECT_STOCK=true
STOCK_POLL_INTERVAL=3.0

# ===================== CTP / SimNow =====================
# SimNow test account: broker 9999. Fill CTP_PASSWORD with your real
# SimNow password before connecting (never commit it).
# Connect via: POST /api/gateways/CTP/connect  (or set AUTO_CONNECT_CTP=true)
# 第一套（交易时段，30xxx 端口）：09:00-15:15 / 21:00-02:30
#   第一组: td 182.254.243.31:30001  md 182.254.243.31:30011
#   第二组: td 182.254.243.31:30002  md 182.254.243.31:30012
#   第三组: td 182.254.243.31:30003  md 182.254.243.31:30013
# 第二套（7x24，40xxx 端口）：交易日 16:00~次日09:00 / 非交易日 16:00~次日12:00
#   td 182.254.243.31:40001  md 182.254.243.31:40011
ENABLE_CTP_GATEWAY=true
AUTO_CONNECT_CTP=true
CTP_USERID=
CTP_PASSWORD=changeme
CTP_BROKERID=9999
CTP_TD_ADDRESS=tcp://182.254.243.31:30001
CTP_MD_ADDRESS=tcp://182.254.243.31:30011
CTP_APPID=simnow_client_test
CTP_AUTH_CODE=0000000000000000

# ===================== AI Assistant (stage 5) =====================
# Provider protocol: "anthropic" (Claude official/relay) or "openai"
# (OpenAI / DeepSeek / Kimi / Qwen / GLM / Doubao / OpenRouter / 中转站).
# 前端"AI 助手"页里也可以随时切换模型（含主流模型快捷预设），改动会持久化，
# 无需重启；这里只是初始默认值。
AI_PROVIDER=anthropic
# API key（对应所选提供商/中转站；留空则 AI 聊天禁用）
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
# 自定义/中转 API 地址（anthropic 协议留空=官方；openai 协议如
# https://api.deepseek.com/v1、https://your-relay.example.com/v1）
ANTHROPIC_BASE_URL=
# Allow the AI to place/cancel orders directly (still risk-checked).
AI_ALLOW_TRADING=false
AI_MAX_TURNS=15
